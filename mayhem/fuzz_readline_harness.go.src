// OSS-Fuzz harness for chzyer/readline (OSS-Fuzz project "go-readline", target FuzzReadline).
// This is the NATIVE Go fuzz harness style: func FuzzX(f *testing.F), built with
// go-118-fuzz-build (OSS-Fuzz's compile_native_go_fuzzer). It constructs a readline Instance
// from the fuzzed prompt string via New(line), then drives Readline() in a loop until the
// stream is exhausted (io.EOF / any error), and Close()s it. The fuzzed surface is the
// readline Instance construction (NewEx/NewTerminal) and the Operation/RuneBuffer line-editing
// state machine reached through Readline().
//
// It lives in package readline (the repo-root package) so go-118-fuzz-build can build it as a
// _test.go file; it is part of the test build only and never affects the normal package build.
// This file is byte-for-byte the OSS-Fuzz harness (projects/go-readline/fuzz_test.go); it is
// shipped here as a NON-.go file (fuzz_readline_harness.go.src) so the Go toolchain never tries
// to compile it as a stray _test.go inside mayhem/ (which would break `go test ./...`). build.sh
// copies it to the repo root as fuzz_test.go at build time.

package readline

import (
	"testing"
)

func FuzzReadline(f *testing.F) {
	f.Fuzz(func(t *testing.T, line string) {
		rl, err := New(line)
		if err != nil {
			return
		}
		defer rl.Close()

		for {
			_, err := rl.Readline()
			if err != nil { // io.EOF
				break
			}
		}
	})
}
